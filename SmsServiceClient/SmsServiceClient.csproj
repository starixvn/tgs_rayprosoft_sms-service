<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <RootNamespace>TGS.SmsService.Client</RootNamespace>
    <PackageId>TGS.SmsServiceClient</PackageId>
    <Version>0.1.1</Version>
    <Authors>Raypro</Authors>
    <Product>TGS.SmsServiceClient</Product>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/sms-service</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/sms-service.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>TGS</PackageTags>
    <AssemblyName>TGS.SmsServiceClient</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncMethodNameFixer" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="System.Interactive.Async" Version="6.0.1" />
	</ItemGroup>
</Project>
