{
	"iisSettings": {
		"windowsAuthentication": false,
		"anonymousAuthentication": true,
		"iisExpress": {
			"applicationUrl": "http://localhost:59131",
			"sslPort": 44330
		}
	},
	"profiles": {
		"IIS Express": {
			"commandName": "IISExpress",
			"launchBrowser": true,
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		"http": {
			"commandName": "Project",
			"dotnetRunMessages": true,
			"launchBrowser": true,
			"applicationUrl": "http://localhost:59131",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Sms-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			}
		},
		"https": {
			"commandName": "Project",
			"launchBrowser": true,
			"launchUrl": "swagger",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Sms-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			},
			"dotnetRunMessages": true,
			"applicationUrl": "https://localhost:5002;http://localhost:59131"
		},
		"Docker": {
			"commandName": "Docker",
			"launchBrowser": true,
			"launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
			"publishAllPorts": true,
			"useSSL": true,
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Sms-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			}
		}
	}
}
