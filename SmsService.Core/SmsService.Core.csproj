<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Tgs.SmsService</RootNamespace>
		<Nullable>enable</Nullable>
		<AssemblyName>Tgs.SmsService.Core</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Protobuf Include="..\Protos\sms.proto" GrpcServices="None" Access="Internal">
			<Link>Protos\sms.proto</Link>
		</Protobuf>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncMethodNameFixer" Version="2.3.0" />
		<PackageReference Include="Google.Protobuf" Version="3.25.2" />
		<PackageReference Include="Grpc.Tools" Version="2.60.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
		<PackageReference Include="PhoenixToolkits.MessageQueue" Version="2.1.0" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
		<PackageReference Include="System.Linq.Async" Version="6.0.1" />
		<PackageReference Include="TGS.ServiceUtility" Version="0.2.0" />
	</ItemGroup>

</Project>
